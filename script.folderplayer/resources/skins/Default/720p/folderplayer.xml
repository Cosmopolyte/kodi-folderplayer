<?xml version="1.0" encoding="UTF-8"?>
<window>
  <defaultcontrol always="true">100</defaultcontrol>
  <controls>
    <!-- background -->
    <control type="image">
      <left>0</left><top>0</top><width>1280</width><height>720</height>
      <texture colordiffuse="FF0E141B">white.png</texture>
    </control>

    <!-- header: current folder + sort (left, above the list) / playing folder (right) -->
    <control type="label">
      <left>24</left><top>14</top><width>270</width><height>36</height>
      <label>$INFO[Control.GetLabel(301)]</label><font>font13</font><textcolor>FFFFFFFF</textcolor>
      <scroll>true</scroll>
    </control>
    <control type="label" id="301"><left>0</left><top>0</top><width>1</width><height>1</height><visible>false</visible><label></label></control>
    <control type="button" id="411">
      <left>302</left><top>10</top><width>124</width><height>36</height>
      <label>✕ Custom</label><font>font12</font><align>center</align>
      <texturenofocus colordiffuse="FF3A2A2A">white.png</texturenofocus><texturefocus colordiffuse="FF9E3F2F">white.png</texturefocus>
      <onleft>100</onleft><onright>403</onright><onup>100</onup><ondown>100</ondown>
      <visible>!String.IsEmpty(Window.Property(has_custom))</visible>
    </control>
    <control type="button" id="403">
      <left>434</left><top>10</top><width>150</width><height>36</height>
      <label>Sort: Name</label><font>font12</font><align>center</align>
      <texturenofocus colordiffuse="FF1E2A38">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
      <onleft>411</onleft><onright>404</onright><onup>100</onup><ondown>100</ondown>
    </control>
    <!-- invisible grab handle over the list: holds the focus while a title is being moved -->
    <control type="button" id="410">
      <left>24</left><top>60</top><width>560</width><height>560</height>
      <label></label>
      <texturenofocus></texturenofocus>
      <texturefocus></texturefocus>
      <onleft>410</onleft><onright>410</onright><onup>410</onup><ondown>410</ondown>
    </control>
    <control type="label">
      <left>620</left><top>14</top><width>636</width><height>36</height>
      <label>[COLOR FF8FA3B7]Playing:[/COLOR] $INFO[Window.Property(playing_folder)]</label><font>font12</font><textcolor>FFC8D2DC</textcolor>
      <align>right</align><scroll>true</scroll>
      <visible>!String.IsEmpty(Window.Property(playing_folder))</visible>
    </control>

    <!-- folder / title list -->
    <control type="list" id="100">
      <left>24</left><top>60</top><width>560</width><height>560</height>
      <onup>403</onup>
      <onright>401</onright>
      <ondown>401</ondown>
      <scrolltime>150</scrolltime>
      <itemlayout height="40">
        <control type="image"><left>0</left><top>0</top><width>560</width><height>40</height><texture colordiffuse="2A6FB3FF">white.png</texture><visible>ListItem.IsSelected</visible></control>
        <control type="image"><left>0</left><top>0</top><width>560</width><height>40</height><texture colordiffuse="CCE0B050">white.png</texture><visible>String.IsEqual(ListItem.Property(moving),1)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFE0B050</textcolor><label>▲</label><visible>String.IsEqual(ListItem.Property(kind),up)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFE0B050</textcolor><label>■</label><visible>String.IsEqual(ListItem.Property(kind),dir)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FF8FA3B7</textcolor><label>♪</label><visible>String.IsEqual(ListItem.Property(kind),audio)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FF8FA3B7</textcolor><label>▶</label><visible>String.IsEqual(ListItem.Property(kind),video)</visible></control>
        <control type="label"><left>40</left><top>0</top><width>400</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFC8D2DC</textcolor><selectedcolor>FF7CE38B</selectedcolor><label>$INFO[ListItem.Label]</label></control>
        <control type="label"><left>440</left><top>0</top><width>112</width><height>40</height><font>font10</font><aligny>center</aligny><align>right</align><textcolor>FF6B7A8A</textcolor><label>$INFO[ListItem.Label2]</label></control>
      </itemlayout>
      <focusedlayout height="40">
        <control type="image"><left>0</left><top>0</top><width>560</width><height>40</height><texture colordiffuse="FF2F5F9E">white.png</texture></control>
        <control type="image"><left>0</left><top>0</top><width>560</width><height>40</height><texture colordiffuse="CCE0B050">white.png</texture><visible>String.IsEqual(ListItem.Property(moving),1)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFFFE08A</textcolor><label>▲</label><visible>String.IsEqual(ListItem.Property(kind),up)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFFFE08A</textcolor><label>■</label><visible>String.IsEqual(ListItem.Property(kind),dir)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFFFFFFF</textcolor><label>♪</label><visible>String.IsEqual(ListItem.Property(kind),audio)</visible></control>
        <control type="label"><left>8</left><top>0</top><width>30</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFFFFFFF</textcolor><label>▶</label><visible>String.IsEqual(ListItem.Property(kind),video)</visible></control>
        <control type="label"><left>40</left><top>0</top><width>400</width><height>40</height><font>font12</font><aligny>center</aligny><textcolor>FFFFFFFF</textcolor><selectedcolor>FF7CE38B</selectedcolor><label>$INFO[ListItem.Label]</label></control>
        <control type="label"><left>440</left><top>0</top><width>112</width><height>40</height><font>font10</font><aligny>center</aligny><align>right</align><textcolor>FFC8D2DC</textcolor><label>$INFO[ListItem.Label2]</label></control>
      </focusedlayout>
    </control>

    <!-- video area -->
    <control type="image">
      <left>620</left><top>60</top><width>636</width><height>358</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <control type="videowindow" id="200">
      <left>620</left><top>60</top><width>636</width><height>358</height>
      <visible>Player.HasVideo</visible>
    </control>
    <control type="visualisation">
      <left>620</left><top>60</top><width>636</width><height>358</height>
      <visible>Player.HasAudio + !Player.HasVideo</visible>
    </control>
    <control type="label">
      <left>620</left><top>60</top><width>636</width><height>358</height>
      <label>♪</label><align>center</align><aligny>center</aligny><font>font45_title</font><textcolor>FF2A3A4A</textcolor>
      <visible>Player.HasAudio + !Player.HasVideo</visible>
    </control>
    <control type="label">
      <left>620</left><top>60</top><width>636</width><height>358</height>
      <label>Select a title …</label><align>center</align><aligny>center</aligny><font>font13</font><textcolor>FF2A3A4A</textcolor>
      <visible>!Player.HasMedia</visible>
    </control>
    <!-- fullscreen: small corner button on the video, like every video player -->
    <control type="button" id="404">
      <left>1204</left><top>366</top><width>44</width><height>44</height>
      <label></label>
      <texturenofocus colordiffuse="AA101820">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
      <onleft>100</onleft><onright>100</onright><onup>403</onup><ondown>406</ondown>
    </control>
    <control type="image">
      <left>1213</left><top>375</top><width>26</width><height>26</height>
      <texture>ic-fullscreen.png</texture>
    </control>

    <!-- now playing -->
    <control type="label" id="300">
      <left>620</left><top>432</top><width>636</width><height>34</height>
      <label></label><font>font12</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll>
    </control>
    <control type="label">
      <left>620</left><top>468</top><width>636</width><height>28</height>
      <label>$INFO[Player.Time] / $INFO[Player.Duration]</label><font>font12</font><textcolor>FF8FA3B7</textcolor>
      <visible>Player.HasMedia</visible>
    </control>
    <!-- seek bar: focusable button around the progress bar; left/right = seek (handled in Python), OK = pause -->
    <control type="button" id="406">
      <left>614</left><top>496</top><width>648</width><height>22</height>
      <label></label>
      <texturenofocus></texturenofocus>
      <texturefocus colordiffuse="66FFFFFF">white.png</texturefocus>
      <onleft>406</onleft><onright>406</onright><onup>404</onup><ondown>401</ondown>
    </control>
    <!-- progress: bright green on black inside a light frame (couch-readable) -->
    <control type="image">
      <left>617</left><top>497</top><width>642</width><height>20</height>
      <texture colordiffuse="FF8FA3B7">white.png</texture>
      <visible>Player.HasMedia</visible>
    </control>
    <control type="image">
      <left>619</left><top>499</top><width>638</width><height>16</height>
      <texture colordiffuse="FF000000">white.png</texture>
      <visible>Player.HasMedia</visible>
    </control>
    <control type="progress">
      <left>620</left><top>500</top><width>636</width><height>14</height>
      <texturebg colordiffuse="FF000000">white.png</texturebg>
      <midtexture colordiffuse="FF7CE38B">white.png</midtexture>
      <info>Player.Progress</info>
      <visible>Player.HasMedia</visible>
    </control>
    <control type="label">
      <left>620</left><top>468</top><width>636</width><height>28</height>
      <label>&lt; &gt; seek 10 s · OK = pause</label><font>font10</font><align>right</align><textcolor>FF8FA3B7</textcolor>
      <visible>Control.HasFocus(406)</visible>
    </control>

    <!-- transport: prev / rewind / play-pause / forward / next / stop -->
    <control type="group">
      <left>620</left><top>540</top>
      <control type="button" id="401">
        <left>0</left><top>0</top><width>101</width><height>44</height>
        <label></label>
        <texturenofocus colordiffuse="FF1E2A38">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
        <onleft>100</onleft><onright>408</onright><onup>406</onup><ondown>100</ondown>
      </control>
      <control type="image"><left>36</left><top>8</top><width>28</width><height>28</height><texture>ic-prev.png</texture></control>
      <control type="button" id="408">
        <left>107</left><top>0</top><width>101</width><height>44</height>
        <label></label>
        <texturenofocus colordiffuse="FF1E2A38">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
        <onleft>401</onleft><onright>407</onright><onup>406</onup><ondown>100</ondown>
      </control>
      <control type="image"><left>143</left><top>8</top><width>28</width><height>28</height><texture>ic-rw.png</texture></control>
      <control type="button" id="407">
        <left>214</left><top>0</top><width>101</width><height>44</height>
        <label></label>
        <texturenofocus colordiffuse="FF1E2A38">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
        <onleft>408</onleft><onright>409</onright><onup>406</onup><ondown>100</ondown>
      </control>
      <control type="image"><left>250</left><top>8</top><width>28</width><height>28</height><texture>ic-pause.png</texture><visible>Player.Playing</visible></control>
      <control type="image"><left>250</left><top>8</top><width>28</width><height>28</height><texture>ic-play.png</texture><visible>!Player.Playing</visible></control>
      <control type="button" id="409">
        <left>321</left><top>0</top><width>101</width><height>44</height>
        <label></label>
        <texturenofocus colordiffuse="FF1E2A38">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
        <onleft>407</onleft><onright>402</onright><onup>406</onup><ondown>100</ondown>
      </control>
      <control type="image"><left>357</left><top>8</top><width>28</width><height>28</height><texture>ic-ff.png</texture></control>
      <control type="button" id="402">
        <left>428</left><top>0</top><width>101</width><height>44</height>
        <label></label>
        <texturenofocus colordiffuse="FF1E2A38">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
        <onleft>409</onleft><onright>405</onright><onup>406</onup><ondown>100</ondown>
      </control>
      <control type="image"><left>464</left><top>8</top><width>28</width><height>28</height><texture>ic-next.png</texture></control>
      <control type="button" id="405">
        <left>535</left><top>0</top><width>101</width><height>44</height>
        <label></label>
        <texturenofocus colordiffuse="FF1E2A38">white.png</texturenofocus><texturefocus colordiffuse="FF2F5F9E">white.png</texturefocus>
        <onleft>402</onleft><onright>100</onright><onup>406</onup><ondown>100</ondown>
      </control>
      <control type="image"><left>571</left><top>8</top><width>28</width><height>28</height><texture>ic-stop.png</texture></control>
    </control>

    <!-- footer hint -->
    <control type="label">
      <left>24</left><top>660</top><width>1232</width><height>30</height>
      <label>OK = open folder / play title   ·   long press OK on an entry = move it (custom order)   ·   Back = folder up / exit</label>
      <font>font10</font><textcolor>FF4A5A6A</textcolor>
      <visible>String.IsEmpty(Window.Property(moving))</visible>
    </control>
    <control type="label">
      <left>24</left><top>660</top><width>1232</width><height>30</height>
      <label>MOVE:   Up / Down = move entry   ·   OK = save custom order   ·   Back = cancel</label>
      <font>font10</font><textcolor>FFE0B050</textcolor>
      <visible>!String.IsEmpty(Window.Property(moving))</visible>
    </control>
  </controls>
</window>
